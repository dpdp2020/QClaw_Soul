#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Video Editor - Assemble intro + title + scenes + BGM into final video."""

import json
import subprocess
import sys
import os
import argparse
from pathlib import Path


def run_ffmpeg(args, label="ffmpeg"):
    cmd = ["ffmpeg", "-y"] + args
    print(f"[{label}] Running: {' '.join(cmd[:10])}...")
    result = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8")
    if result.returncode != 0:
        print(f"[{label}] STDERR:\n{result.stderr[-2000:]}")
        raise RuntimeError(f"{label} failed (exit {result.returncode})")
    return result


def generate_title_frame(title, output_path, config):
    """Generate title frame: yellow text on semi-transparent black background.
    
    Uses a Python helper script to call ffmpeg with proper UTF-8 encoding,
    avoiding Windows subprocess encoding issues.
    """
    w, h = config["resolution"].split("x")
    fontsize = config.get("font_size", 70)
    duration = config.get("title_duration", 4)

    # Copy font to workspace to avoid Chinese path encoding issues
    import shutil
    font_local = Path(output_path).parent / "font_autumn.ttf"
    src_font = r"C:\Windows\Fonts\字魂241号-秋枫体.ttf"
    shutil.copy2(src_font, str(font_local))
    font_path = str(font_local).replace(chr(92), '/')

    # Write a helper script that calls ffmpeg directly (avoids subprocess encoding)
    helper = Path(output_path).parent / "_gen_title.py"
    title_escaped = title.replace("\\", r"\\\\").replace("'", r"\\'").replace(":", r"\\:").replace("\n", r"\\n")
    # Title position: upper 1/3 of screen
    title_y = f"h/3 - text_h/2"
    helper.write_text(f'''# -*- coding: utf-8 -*-
import subprocess, sys, os
os.environ["PATH"] = os.environ.get("PATH", "")
ffmpeg = "ffmpeg"
title = r"""{title}"""
cmd = [
    ffmpeg, "-y",
    "-f", "lavfi", "-i", f"color=c=black:s={w}x{h}:d={duration}:r=30",
    "-vf", f"drawbox=x=0:y=0:w=iw:h=ih:color=black@0.5:t=fill,drawtext=text={{title}}:fontfile={font_path}:fontsize={fontsize}:fontcolor=yellow:x=(w-text_w)/2:y={title_y}",
    "-c:v", "libx264", "-preset", "medium", "-pix_fmt", "yuv420p", "-r", "30",
    r"""{output_path}"""
]
print("CMD:", cmd)
r = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace")
print("STDOUT:", r.stdout[-500:] if r.stdout else "")
print("STDERR:", r.stderr[-1000:] if r.stderr else "")
if r.returncode != 0:
    sys.exit(1)
''', encoding="utf-8")

    # Run helper with proper encoding
    env = os.environ.copy()
    env["PYTHONIOENCODING"] = "utf-8"
    result = subprocess.run(
        [sys.executable, str(helper)],
        capture_output=True, text=True, encoding="utf-8", errors="replace",
        env=env
    )
    print(result.stdout[-500:])
    if result.returncode != 0:
        print(result.stderr[-1000:])
        raise RuntimeError(f"title_frame failed")

    helper.unlink(missing_ok=True)
    font_local.unlink(missing_ok=True)
    return output_path


def concat_videos(video_files, output_path, transition=0.5):
    """Concatenate multiple video files with crossfade transitions.
    
    Normalizes all inputs to 30fps and 720x1280 to avoid timebase mismatches.
    """
    if len(video_files) == 1:
        run_ffmpeg(["-i", video_files[0], "-c", "copy", output_path], label="concat_single")
        return output_path

    n = len(video_files)
    target_fps = 30
    target_w, target_h = 720, 1280

    # Normalize each video to 30fps + target resolution
    normalized = []
    for i, f in enumerate(video_files):
        norm_path = str(Path(f).parent / f"_norm_{i}.mp4")
        # Check if input has audio
        has_audio = has_audio_stream(f)
        if has_audio:
            run_ffmpeg([
                "-i", f,
                "-vf", f"fps={target_fps},scale={target_w}:{target_h}:force_original_aspect_ratio=decrease,pad={target_w}:{target_h}:(ow-iw)/2:(oh-ih)/2",
                "-c:v", "libx264", "-preset", "fast", "-pix_fmt", "yuv420p",
                "-c:a", "aac", "-b:a", "192k",
                norm_path
            ], label=f"norm_{i}")
        else:
            run_ffmpeg([
                "-i", f,
                "-vf", f"fps={target_fps},scale={target_w}:{target_h}:force_original_aspect_ratio=decrease,pad={target_w}:{target_h}:(ow-iw)/2:(oh-ih)/2",
                "-c:v", "libx264", "-preset", "fast", "-pix_fmt", "yuv420p",
                "-an",  # no audio in source
                norm_path
            ], label=f"norm_{i}")
        normalized.append(norm_path)

    inputs = []
    for f in normalized:
        inputs.extend(["-i", f])

    # xfade chain for video
    filter_parts = []
    offset = 0
    prev_v_label = "[0:v]"
    for i in range(1, n):
        next_v_label = f"[v{i}]" if i < n - 1 else "[vout]"
        dur = get_video_duration(normalized[i - 1])
        offset += dur - transition
        filter_parts.append(
            f"{prev_v_label}[{i}:v]xfade=transition=fade:duration={transition}:offset={offset:.3f}{next_v_label}"
        )
        prev_v_label = next_v_label

    has_any_audio = any(has_audio_stream(f) for f in normalized)

    if has_any_audio:
        # Two-step: xfade video only, then concat audio via demuxer, then merge
        video_only = str(Path(output_path).with_suffix(".vo.mp4"))
        filter_complex = ";".join(filter_parts)
        run_ffmpeg(
            inputs + [
                "-filter_complex", filter_complex,
                "-map", "[vout]",
                "-c:v", "libx264", "-preset", "medium", "-pix_fmt", "yuv420p",
                video_only
            ],
            label="concat_xfade_video"
        )

        # Concat audio tracks using concat demuxer (for segments with audio)
        # Add silence for segments without audio
        audio_parts = []
        for i, f in enumerate(normalized):
            if has_audio_stream(f):
                audio_parts.append(f)
            else:
                # Generate silence matching video duration
                dur = get_video_duration(f)
                sil_path = str(Path(f).with_suffix(".sil.mp4"))
                run_ffmpeg([
                    "-f", "lavfi", "-i", f"anullsrc=r=44100:cl=stereo",
                    "-t", str(dur),
                    "-c:a", "aac", "-b:a", "192k",
                    sil_path
                ], label=f"silence_{i}")
                audio_parts.append(sil_path)

        # Write concat list for audio
        concat_list = str(Path(output_path).parent / "_audio_concat.txt")
        with open(concat_list, "w", encoding="utf-8") as cf:
            for ap in audio_parts:
                p = str(ap).replace("\\", "/")
                cf.write(f"file '{p}'\n")

        audio_only = str(Path(output_path).with_suffix(".ao.aac"))
        run_ffmpeg([
            "-f", "concat", "-safe", "0", "-i", concat_list,
            "-c:a", "aac", "-b:a", "192k",
            audio_only
        ], label="concat_audio")

        # Merge video + audio
        run_ffmpeg([
            "-i", video_only, "-i", audio_only,
            "-c:v", "copy", "-c:a", "aac", "-b:a", "192k",
            "-shortest",
            output_path
        ], label="merge_av")

        # Cleanup
        for p in [video_only, audio_only, concat_list] + [str(Path(f).with_suffix(".sil.mp4")) for f in normalized if not has_audio_stream(f)]:
            try: Path(p).unlink(missing_ok=True)
            except: pass
    else:
        filter_complex = ";".join(filter_parts)
        run_ffmpeg(
            inputs + [
                "-filter_complex", filter_complex,
                "-map", "[vout]",
                "-c:v", "libx264", "-preset", "medium", "-pix_fmt", "yuv420p",
                output_path
            ],
            label="concat_xfade"
        )

    # Cleanup normalized files
    for f in normalized:
        try: Path(f).unlink(missing_ok=True)
        except: pass

    return output_path


def has_audio_stream(filepath):
    """Check if a video file has an audio stream."""
    cmd = [
        "ffprobe", "-v", "error",
        "-select_streams", "a",
        "-show_entries", "stream=codec_type",
        "-of", "default=noprint_wrappers=1:nokey=1",
        filepath
    ]
    result = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8")
    return result.stdout.strip() != ""

def get_video_duration(filepath):
    cmd = [
        "ffprobe", "-v", "error",
        "-show_entries", "format=duration",
        "-of", "default=noprint_wrappers=1:nokey=1",
        filepath
    ]
    result = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8")
    return float(result.stdout.strip())


def has_audio(filepath):
    cmd = [
        "ffprobe", "-v", "error",
        "-select_streams", "a",
        "-show_entries", "stream=codec_type",
        "-of", "default=noprint_wrappers=1:nokey=1",
        filepath
    ]
    result = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8")
    return "audio" in result.stdout.strip()


def add_bgm(video_path, bgm_path, output_path, volume=0.35):
    """Add BGM to video (handles both with-audio and no-audio cases)."""
    video_dur = get_video_duration(video_path)
    audio_exists = has_audio(video_path)

    if audio_exists:
        filter_complex = (
            f"[1:a]volume={volume},afade=t=out:st={video_dur - 2}:d=2[bgm];"
            f"[0:a][bgm]amix=inputs=2:duration=first:dropout_transition=2[aout]"
        )
    else:
        filter_complex = (
            f"[1:a]volume={volume},afade=t=out:st={video_dur - 2}:d=2,apad[aout]"
        )

    run_ffmpeg([
        "-i", video_path,
        "-i", bgm_path,
        "-filter_complex", filter_complex,
        "-map", "0:v", "-map", "[aout]",
        "-c:v", "copy", "-c:a", "aac", "-b:a", "192k",
        "-t", str(video_dur),
        output_path
    ], label="add_bgm")
    return output_path


def main():
    parser = argparse.ArgumentParser(description="Video Editor - Assemble final video")
    parser.add_argument("--config", required=True, help="Path to config JSON")
    parser.add_argument("--workspace", default=".", help="Workspace directory for temp files")
    args = parser.parse_args()

    workspace = Path(args.workspace)
    workspace.mkdir(parents=True, exist_ok=True)

    with open(args.config, "r", encoding="utf-8") as f:
        config = json.load(f)

    scenes = [Path(s) for s in config["scenes"]]
    bgm_path = config.get("bgm", "")
    title = config.get("title", "")
    intro_video = config.get("intro_video", "")
    bgm_vol = config.get("bgm_volume", 0.35)
    transition = config.get("scene_transition", 0.5)
    output = config.get("output", "final.mp4")

    w, h = config.get("resolution", "720x1280").split("x")

    parts = []

    # 1. Intro (use video file if provided, otherwise generate black screen)
    if intro_video and Path(intro_video).exists():
        intro_path = workspace / "_intro.mp4"
        intro_dur = get_video_duration(intro_video)
        # Normalize intro to target resolution + fps (keep audio if present)
        intro_has_audio = has_audio_stream(intro_video)
        if intro_has_audio:
            run_ffmpeg([
                "-i", intro_video,
                "-vf", f"fps=30,scale={w}:{h}:force_original_aspect_ratio=decrease,pad={w}:{h}:(ow-iw)/2:(oh-ih)/2",
                "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p",
                "-c:a", "aac", "-b:a", "192k",
                intro_path
            ], label="intro")
        else:
            run_ffmpeg([
                "-i", intro_video,
                "-vf", f"fps=30,scale={w}:{h}:force_original_aspect_ratio=decrease,pad={w}:{h}:(ow-iw)/2:(oh-ih)/2",
                "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p",
                "-an",
                intro_path
            ], label="intro")
        parts.append(str(intro_path))
        print(f"[+] Intro video: {intro_dur}s ({Path(intro_video).name})")
        # Title duration matches intro duration
        config["title_duration"] = intro_dur
    else:
        intro_dur = config.get("intro_duration", 3)
        intro_path = workspace / "_intro.mp4"
        run_ffmpeg([
            "-f", "lavfi", "-i", f"color=c=black:s={w}x{h}:d={intro_dur}:r=30",
            "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p",
            intro_path
        ], label="intro")
        parts.append(str(intro_path))
        print(f"[+] Intro: {intro_dur}s black")

    # 2. Title frame
    if title:
        title_path = workspace / "_title.mp4"
        generate_title_frame(title, str(title_path), config)
        parts.append(str(title_path))
        print(f"[+] Title: '{title}'")

    # 3. Scene videos
    for s in scenes:
        if not s.exists():
            print(f"[!] Scene not found: {s}")
            continue
        parts.append(str(s))
        print(f"[+] Scene: {s.name}")

    if len(parts) < 2:
        print("[!] Not enough parts to assemble"); sys.exit(1)

    # 4. Concat
    if len(parts) == 1:
        concat_path = parts[0]
    else:
        concat_path = str(workspace / "_concat.mp4")
        concat_videos(parts, concat_path, transition)
        print(f"[+] Concatenated {len(parts)} parts")

    # 5. BGM
    if bgm_path and Path(bgm_path).exists():
        final = add_bgm(concat_path, bgm_path, str(workspace / output), bgm_vol)
        print(f"[+] BGM mixed at {int(bgm_vol * 100)}%")
    else:
        # Copy concat to output path when no BGM
        import shutil
        out_path = str(workspace / output)
        if concat_path != out_path:
            shutil.move(concat_path, out_path)
        final = out_path
        print("[i] No BGM")

    # 6. Verify
    final_path = Path(final)
    if not final_path.exists():
        print("[!] Final video missing!"); sys.exit(1)

    dur = get_video_duration(final)
    size = final_path.stat().st_size
    print(f"\n{'=' * 50}")
    print(f"Done: {final_path.resolve()}")
    print(f"  Duration: {dur:.1f}s | Size: {size / 1024 / 1024:.1f} MB")
    print(f"{'=' * 50}")

    # Cleanup temp files (only workspace-generated, NOT source scene files)
    source_scenes = [str(s) for s in scenes]
    for p in parts:
        if p in source_scenes:
            continue  # never delete original source files
        try: Path(p).unlink(missing_ok=True)
        except: pass
    try: Path(concat_path).unlink(missing_ok=True)
    except: pass


if __name__ == "__main__":
    main()
